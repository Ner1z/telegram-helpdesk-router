# Telegram bot credentials from @BotFather.
BOT_TOKEN=123456789:replace-with-real-token

# 16-256 characters [A-Za-z0-9_-]. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TELEGRAM_WEBHOOK_SECRET=replace-with-generated-secret

# Default admin group/supergroup ID (negative). The bot must be a member.
DEFAULT_ADMIN_CHAT_ID=-1001234567890

# Comma-separated Telegram user IDs allowed to use admin commands.
ADMIN_USER_IDS=111111111,222222222

# Optional multi-queue routing. Empty value creates general/tech/billing
# categories, all routed to DEFAULT_ADMIN_CHAT_ID.
# Example:
# TICKET_ROUTES_JSON={"general":{"title":"Общие вопросы","emoji":"💬","chat_id":-1001111111111},"tech":{"title":"Техподдержка","emoji":"🛠","chat_id":-1002222222222,"message_thread_id":42}}
TICKET_ROUTES_JSON=

# Upstash Redis REST credentials (TLS). Use a dedicated database or a unique prefix.
UPSTASH_REDIS_REST_URL=https://replace.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
REDIS_KEY_PREFIX=helpdesk

ENVIRONMENT=production
LOG_LEVEL=INFO

# Optional. Used by scripts/set_webhook.py and scripts/smoke_test.py.
# PUBLIC_BASE_URL=https://telegram-helpdesk-router.vercel.app

RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_MESSAGES=12
PENDING_CATEGORY_TTL_SECONDS=1800
TICKET_TTL_SECONDS=2592000
BAN_TTL_SECONDS=31536000
TELEGRAM_API_TIMEOUT_SECONDS=20
WEBHOOK_MAX_BODY_BYTES=1048576
# UPDATE_LOCK_SECONDS=120
# UPDATE_DEDUPLICATION_TTL_SECONDS=86400
# USER_TICKET_HISTORY_LIMIT=50
# MAX_USER_MESSAGE_LENGTH=3000
# MAX_ADMIN_MESSAGE_LENGTH=4000
